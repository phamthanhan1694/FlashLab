{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlashLab",
  "version": "1.0.0",
  "identifier": "com.flashlab.app",
  "build": {
    "frontendDist": "bootstrap"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlashLab",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
