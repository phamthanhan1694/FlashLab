{
  "name": "flashlab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "typecheck": "npm run build -w @flashlab/shared && npm run typecheck --workspaces --if-present",
    "build": "node scripts/clean.mjs && npm run build -w @flashlab/shared && npm run build -w @flashlab/frontend && npm run build -w @flashlab/backend",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "test": "npm run build -w @flashlab/shared && npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "node --test scripts/smoke-ui.mjs scripts/smoke-profiles.mjs",
    "test:server": "node --test scripts/smoke-server.mjs",
    "dev:services": "npm run build -w @flashlab/shared && concurrently -k -n api,web \"npm run dev -w @flashlab/backend\" \"npm run dev -w @flashlab/frontend\"",
    "test:config": "node --test scripts/config.test.mjs scripts/readiness.test.mjs scripts/smoke-dev.mjs",
    "tauri": "node scripts/tauri.mjs",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "test:desktop": "node --test scripts/smoke-desktop.mjs",
    "android:init": "node scripts/tauri.mjs android init",
    "android:dev": "node scripts/tauri.mjs android dev",
    "android:build": "node scripts/tauri.mjs android build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
